{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronicle",
  "version": "0.1.2",
  "identifier": "com.chronicle.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && node scripts/bundle-daemon.mjs",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Chronicle",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/chronicle-daemon", "binaries/chronicle-focus-monitor"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
